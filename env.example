# Travel Assistant Environment Variables
# Copy this file to .env and fill in your actual values

# Google Maps API Configuration
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ChatGPT API Configuration
VITE_CHATGPT_API_KEY=your_chatgpt_api_key_here

# Backend API Configuration
VITE_USE_BACKEND_API=true
VITE_API_BASE_URL=http://localhost:8001/api/v1
VITE_HTTP_TIMEOUT=10000

# Environment
VITE_NODE_ENV=production

# Auth & CORS configuration shared with backend (for Docker/dev convenience)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
CORS_ALLOW_HEADERS=Content-Type,Authorization,X-Requested-With
CORS_EXPOSE_HEADERS=Set-Cookie,Authorization
CORS_MAX_AGE=3600
REFRESH_TOKEN_COOKIE_NAME=refresh
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax

# Database Configuration (for Docker)
DATABASE_URL=postgresql+asyncpg://travel_user:travel_password@db:5432/travel_assistant_auth
SECRET_KEY=your-super-secret-key-change-in-production-make-it-very-long-and-random
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
API_PREFIX=/api/v1
ENV=production
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000


