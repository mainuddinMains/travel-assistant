# Database Configuration
DATABASE_URL=sqlite+aiosqlite:///./travel_assistant.db

# JWT Configuration
SECRET_KEY=your-secret-key-here-change-in-production-make-it-long-and-random
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
CORS_ALLOW_HEADERS=Content-Type,Authorization,X-Requested-With
CORS_EXPOSE_HEADERS=Set-Cookie,Authorization
CORS_MAX_AGE=3600

# ChatGPT API Configuration
CHATGPT_API_KEY=your_chatgpt_api_key_here

# Google Maps API Configuration
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Application Configuration
API_PREFIX=/api/v1
ENV=dev
LOG_LEVEL=INFO
REFRESH_TOKEN_COOKIE_NAME=refresh
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
